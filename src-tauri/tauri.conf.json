{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InputMaster",
  "identifier": "com.midimaster.midimaster",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/virtual-audio/Build-VirtualAudio.ps1 -Configuration Release",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "InputMaster",
        "width": 1480,
        "height": 820,
        "minWidth": 1280,
        "minHeight": 820,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; connect-src 'self' https: http: ws: wss:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": ["icons/InputMaster.png", "icons/icon.ico"],
    "resources": {
      "../virtual-audio/dist": "virtual-audio"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQjhGQkY0OEQ2ODU1Q0IKUldUTFZXaU45UHU0SUE3K3EwbW1vcWpBdldkamwvUmNSL3BMTUR4VmRYREhNRGVDRHYyTlFwOVcK",
      "endpoints": [
        "https://updates.inputmaster.app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
